# OpenAI (LLM, embeddings y opcionalmente Whisper API)
OPENAI_API_KEY=sk-your-key-here

# Modelos
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# STT local (faster-whisper). Valores: tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Rutas internas (relativas a backend/)
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
CHROMA_DIR=./data/chroma
DATABASE_URL=sqlite+aiosqlite:///./data/sessions.db

# CORS (URL del frontend Next.js)
CORS_ORIGINS=http://localhost:3000

# RAG
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVAL_K=6
